APP_NAME=Courier App Demo
ENVIRONMENT=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://courier:courier@localhost:5432/courier_db
POSTGRES_DB=courier_db
POSTGRES_USER=courier
POSTGRES_PASSWORD=courier
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
VOLUMETRIC_DIVISOR=5000
PUBLIC_BASE_URL=http://127.0.0.1:8001
SMTP_HOST=localhost
DOCKER_SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@courier-app-demo.local
SMTP_USE_TLS=false

# Optional: only needed if the default host port below is already used by
# another local project (e.g. another Dockerized PostgreSQL). Uncomment and
# change just the ones you need - containers always reach each other over
# their normal internal ports regardless of these values.
# APP_PORT=8001
# POSTGRES_PORT=5432
# MAILPIT_WEB_PORT=8025
# MAILPIT_SMTP_PORT=1025
